# Copier ce fichier en .env et renseigner tes propres valeurs.

PORT=4000

# Signature des jetons de session (change cette valeur en production)
JWT_SECRET=change-moi-en-production

# Chemin du fichier SQLite (par défaut : backend/data/teny_malagasy.sqlite)
# DB_PATH=./data/teny_malagasy.sqlite

# Nécessaire uniquement pour activer la vérification réelle des jetons
# Google/Facebook envoyés par le frontend (voir frontend/js/auth.js) :
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
