# Port du backend
# Railway fournit automatiquement PORT en production.
# Cette valeur sert surtout en développement local.
PORT=4000


# Environnement
NODE_ENV=development


# URL de connexion PostgreSQL
#
# En local :
# DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/teny_malagasy
#
# Sur Railway, configure cette variable dans le tableau de bord :
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=


# Signature des jetons JWT
# Utilise une longue valeur aléatoire en production.
JWT_SECRET=change-moi-en-production


# URL du frontend autorisée par le CORS
#
# En local :
# FRONTEND_URL=http://localhost:5173
#
# En production :
# FRONTEND_URL=https://ton-frontend.vercel.app
FRONTEND_URL=http://localhost:5173


# Identifiants OAuth facultatifs
# Laisse vide si Google/Facebook ne sont pas encore activés.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=